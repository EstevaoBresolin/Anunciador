@inject IJSRuntime _jsRuntime
@inject ISnackbar Snackbar

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<NavigationLock OnBeforeInternalNavigation="TrocarUrl" />
<div class="main">

    <!-- Menu de Navegação -->
    <MudPaper Class="mud-background-secondary menu-bar">
        <div style="display: flex;justify-content: space-between;align-items: center;background: #000000 ;position: absolute;width: 100%; z-index: 2;">
            <MudIconButton OnClick="OpenMenu" Icon="@Icons.Material.Filled.Menu" Color="Color.Default" style="color: white !important;" />
            <MudLink Href="@navigation.BaseUri" style="font-size: 1rem; color: white !important;"> <img style="max-height: 35px; " src="imgs/concete-fé-logo-branco-escrita-horizontal.png"/> </MudLink>
            @* @if (FirestoreService.IsAuthenticated)
            {
                <MudIconButton style="color: white !important;" Icon="@Icons.Material.Filled.Logout" Color="Color.Default" OnClick="Logout" />
            }
            else{
                <MudIconButton style="color: white !important;" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Default" OnClick="Logar" />
            } *@
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color=Color.Inherit Style="color: white !important; padding-bottom: 0 !important;">
        
                    @if (FirestoreService.IsAuthenticated){
                        <MudMenuItem Href="/minha-conta">
                            <img style="width: 20px;" src="imgs/icone-9.png"/>
                            Minha Conta
                        </MudMenuItem>

                        <MudMenuItem OnClick="AcessarPortalCliente">
                            <img style="width: 20px;" src="imgs/icone-7.png"/>

                            Assinatura
                        </MudMenuItem>

                        <MudMenuItem OnClick="Logout" Style="background-color: #C62828; color: white; border-radius: 8px; width: 80%; padding: 0.2rem; margin: auto;">
                            <img style="width: 20px;" src="imgs/icone-10.png"/>

                            Sair
                        </MudMenuItem>
                    }
                    else{
                        <MudMenuItem OnClick="Logar" >
                            <img style="width: 20px;" src="imgs/icone-9.png"/>
                            Entrar
                        </MudMenuItem>
                    }

                </MudMenu>


        </div>
        <!-- Ícone de Menu -->
        <!-- Links de Navegação -->
        @if (collapseNavMenu)
        {
            <div class="menu-container" @onclick="() => CloseMenu()">
                <MudContainer Style="padding-left: 0 !important; padding-right: 0 !important;" Class="menu d-flex justify-space-between align-center px-4">

                    <MudContainer Class="d-flex justify-center align-center menu-itens">
                        <MudLink Href="@navigation.BaseUri" Class="menu-item"> <img style="width: 25px;" src="imgs/Prancheta1.png"/> Todos os Departamentos</MudLink>
                        <MudLink Href="consultoria" Class="menu-item"> <img style="width: 25px;" src="imgs/icone-6.png"/> Profissionais e Consultoria Especializada</MudLink>
                        <MudLink Href="informatica" Class="menu-item"> <img style="width: 25px;" src="imgs/icone-2.png"/> Construção, Manutenção e Tecnologia</MudLink>
                        <MudLink Href="saudeEBeleza" Class="menu-item"> <img style="width: 25px;" src="imgs/icone-3.png"/>Serviços Pessoais e Bem-estar</MudLink>
                        <MudLink Href="comercio" Class="menu-item"><img style="width: 25px;" src="imgs/icone-4.png"/> Indústria e Comércio</MudLink>

                        @if (FirestoreService.IsAuthenticated)
                        {
                            @* <MudLink Href="minha-conta" Class="menu-item"><MudIcon Icon="@Icons.Material.Filled.AccountCircle" Title="Favorite" />Minha Conta</MudLink> *@
                            @if(FirestoreService.IsAdm){
                                <MudLink Href="administrador" Style="background-color: #000000; color: white !important;" Class="menu-item"> <img style="width: 25px;" src="imgs/icone-8.png"/>Administrador</MudLink>

                            }

                        }
                            <MudLink Href="produtos" Class="menu-item-assinatura"><img style="width: 25px;" src="imgs/icone-7.png"/>Assinatura</MudLink>
                      

                        <div class="infos">
                            <p>Conecte Fé</p>
                            <p>Versão 1.0.0</p>
                        </div>

                    </MudContainer>

                </MudContainer>
            </div>
        }


    </MudPaper>

    <main style="padding-top: 3rem;">
        <article class="@(navigation.Uri.Contains("login") ? "login" : navigation.Uri.Contains("registrar") ? "login" : navigation.Uri.Contains("esqueceuSenha") ? "login" : "content px-4")">
            @Body
        </article>
    </main>
</div>

@code {

    private bool _isDarkMode;
    private bool expand = false;
    private bool _drawerOpen = true;
    private bool collapseNavMenu = false;

    private string searchString1 = "";
    private string currentIcon = Icons.Material.Filled.DarkMode;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private MudTheme _theme;
    private MudTheme LightTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#424242",
            Secondary = "#FFFFFF",
        }
    };
    private MudTheme DarkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#FFFFFF7F",
            Secondary = "#000000"
        }
    };

    private void Logar()
    {
        navigation.NavigateTo("login");
    }

    private void Logout()
    {
        FirestoreService.SetAuthenticated(false);
        FirestoreService.NomeUsuario = "";
        FirestoreService.Logout();
        navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task AcessarPortalCliente()
    {
        User infos = new User();

        infos = await FirestoreService.GetStatusAssinatura();

        try{
            if(infos == null || infos?.Status != "active")
            {
                navigation.NavigateTo("produtos");

            }
            else{
                await _jsRuntime.InvokeVoidAsync("firebaseService.createLinkPortalCliente", navigation.BaseUri);
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao acessar o portal do cliente: {ex.Message}");
        }
        finally{
            @* await Task.Delay(2000); *@
            @* redirecionando = false; *@
        }
    }

    private async Task TrocarUrl(LocationChangingContext context)
    {
        collapseNavMenu = false;
        StateHasChanged();
    }

    private void OpenMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseMenu()
    {
        collapseNavMenu = false;
        StateHasChanged(); // Garante a atualização do estado da UI
    }

    private void ToggleTheme()
    {
        _theme = _theme == LightTheme ? DarkTheme : LightTheme;

        currentIcon = _theme == LightTheme ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode;
    }

    public void DarkMode()
    {
        _isDarkMode = !_isDarkMode;

        if (_isDarkMode)
        {
            currentIcon = Icons.Material.Filled.LightMode;
        }
        else
        {
            currentIcon = Icons.Material.Filled.DarkMode;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await FirestoreService.InicializarAsync();

        // string uid = await FirestoreService.GetCurrentUserId();
    }

    protected override void OnInitialized()
    {
        FirestoreService.OnAuthStateChanged += StateHasChanged;

    }

    public void Dispose()
    {
        FirestoreService.OnAuthStateChanged -= StateHasChanged;
    }
}


