@page "/"
@using AnunciadorV1.Models
@using AnunciadorV1.Services
@inject FirestoreService FirestoreService

<PageTitle>Home</PageTitle>

<MudContainer Class="text-center my-6">
    <div class="container1">
        <MudText Typo="Typo.h5" Style="font-size: 32px; text-align: start;" Class="mb-2 container1-divs">
            Seu portal <br> completo de <br> <MudText Typo="Typo.h5" Style="font-weight: bold; font-size: 32px;">serviços online</MudText>
        </MudText>

        <img src="imgs/concete-fé-logo-preto-escrita-vertical.png" alt="Logo Conecte Fé" style="margin: 20px auto; max-width: 265px;" class="container1-divs"/>

        <MudStack Direction="Row" Style="justify-content: space-between; text-align: end;" Class="my-4 container1-divs">
            <MudText Style="font-size: 32px;" Typo="Typo.h6">Comece a anunciar hoje e veja seu serviço <br> <b>prosperar!</b></MudText>
        </MudStack>
    </div>
    

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="3" Class="pa-4 rounded-xl section2" Style="background: url('imgs/Pattern-colorido-semfundo.png'); background-size: cover;">
                <div class="section-2-fundo" style="">
                </div>
                <div style="position: relative; z-index: 2;">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudChip Class="chips" T="string"> O que é?</MudChip>
                    </MudText>
                    <MudText Class="section2-texts">
                        O Conecte Fé é uma plataforma que conecta membros de igrejas cristãs a uma rede de profissionais
                        e prestadores de serviços qualificados. Nosso objetivo é facilitar o encontro entre quem oferece
                        e quem busca serviços, promovendo oportunidades, networking e o fortalecimento da comunidade cristã.
                    </MudText>
                </div> 
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudPaper Elevation="3" Class="pa-4 rounded-xl section2" Style="background: url('imgs/Pattern-colorido-semfundo.png'); background-size: cover;">
                <div class="section-2-fundo" style="">
                </div>
                <div style="position: relative; z-index: 2;">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudChip Class="chips" T="string"> Como funciona?</MudChip>
                    </MudText>
                    <MudText Class="section2-texts">
                        Profissionais e prestadores de serviços se cadastram na plataforma e divulgam
                        seus serviços. Membros da igreja podem acessar gratuitamente e buscar por
                        serviços conforme suas necessidades, utilizando filtros de categoria, nome
                        ou especialidade. O contato é feito diretamente entre o profissional e o
                        interessado, sem intermediação.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudPaper Elevation="3" Class="pa-4 rounded-xl section2" Style="background: url('imgs/Pattern-colorido-semfundo.png'); background-size: cover;">
                <div class="section-2-fundo" style="">
                </div>
                <div style="position: relative; z-index: 2;">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        <MudChip Class="chips" T="string">Como assino?</MudChip>
                    </MudText>
                    <MudText Class="section2-texts">
                        Se você é um profissional ou prestador de serviços, basta realizar o cadastro na plataforma,
                        efetuar o pagamento da mensalidade e preencher as informações do seu anúncio. Após a confirmação,
                        seu anúncio será publicado e poderá ser visualizado por todos os membros da comunidade.
                        Já os membros da igreja podem utilizar a plataforma gratuitamente, sem necessidade de cadastro.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@if (Anunciantes is null)
{
    <p>Carregando...</p>
}
else
{
    
    <MudContainer Class="d-flex align-center barra-pesquisa" Style="gap: 8px; border-radius: 25px;">
        <MudTextField @bind-Value="@searchText"
                    Placeholder="Buscar..."
                    Adornment="Adornment.None"
                    Class="mud-elevation-2 input-search">
        </MudTextField>

        <MudIconButton Icon="@Icons.Material.Filled.Search"
                    Style="width: 45px; height: 45px; border-radius: 50%; color: white !important; background: #2274a8;"
                    Color=Color.Inherit
                    OnClick="Pesquisar" />

       
    </MudContainer>
    <div class="container">
        @if (Anunciantes.Count == 0){
            <p>Nenhum encontrado</p>
        }
        @foreach (var anunciante in Anunciantes)
        {
           <div class="anunciante-card">

                <img src="@anunciante.EnderecoFoto" alt="Foto" class="anunciante-img" />

                <div class="anunciante-body">
                    <p class="anunciante-nome">@anunciante.Nome</p>
                    <p class="anunciante-titulo">@anunciante.Titulo</p>
                    <p class="anunciante-descricao">@anunciante.Descricao</p>
                    <p class="anunciante-descricao">
                        <strong>Endereço:</strong> 
                        @(!string.IsNullOrWhiteSpace(anunciante.Endereco) ? @anunciante.Endereco : "Não possui endereço fixo")
                    </p>

                    <div class="anunciante-actions">
                        <a class="btn-whatsapp"
                        href="@($"https://wa.me/{anunciante.Numero}?text={Uri.EscapeDataString("Olá, vim do ConecteFé e gostaria de mais informações!")}")"
                        target="_blank">
                            <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" class="icon-social" />
                        </a>

                        @if (!string.IsNullOrWhiteSpace(anunciante.Instagram))
                        {
                            <a class="btn-instagram"
                            href="@($"https://www.instagram.com/{anunciante.Instagram}")"
                            target="_blank">
                                <MudIcon Icon="@Icons.Custom.Brands.Instagram" class="icon-social" />
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(anunciante.Endereco))
                        {
                            <a class="btn-maps"
                            href="@($"https://www.google.com/maps/search/{Uri.EscapeDataString(anunciante.Endereco)}")"
                            target="_blank">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" class="icon-social" />
                            </a>
                        }
                    </div>
                </div>
            </div>

        }

    </div>

}

@code {
    private string searchText = "";

    private List<Anunciante>? Anunciantes;
    private List<Anunciante>? AnunciantesOriginal;

    protected override async Task OnInitializedAsync()
    {
        AnunciantesOriginal = await FirestoreService.GetAnunciantes();
        var produtos = await FirestoreService.GetProdutos();

        Anunciantes = AnunciantesOriginal.OrderByDescending(a => a.DataAnuncio).ToList();
    }

    private void Pesquisar()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            Anunciantes = AnunciantesOriginal;
            return;
        }

        Anunciantes = AnunciantesOriginal?
            .Where(a => a.Nome.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        a.Descricao.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        a.Titulo.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(a => a.DataAnuncio).ToList();
    }

}

<style>
