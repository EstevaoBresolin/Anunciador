@page "/login"
@using AnunciadorV1.Services

@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject FirestoreService FirestoreService
@inject NavigationManager navigation

<div style="background: url('imgs/Pattern-colorido-semfundo.png'); background-size: contain; width: 100vw; height: 95vh; position: absolute; z-index: 1; opacity: 0.1; margin-top: -2rem; margin-left: -2rem;">

</div>
<MudContainer Class="d-flex justify-center align-center" Style="height: 95vh; margin-top: -1px;max-width: none; z-index: 2; position: relative; padding: 0;">
    <MudPaper Class="p-6 rounded-lg shadow-lg" Style="width: 400px; background-color: white;">
        <MudText Typo="Typo.h5" Style="background: linear-gradient(90deg, #2274a8, #d16776, #ff5d04); text-align: center; color: white; width: fit-content; padding: 0.5rem; border-radius: 12px; margin: auto; margin-bottom: 2rem; font-size: 30px; font-weight: bold; margin-top: -2rem;" 
        GutterBottom="true">Bem-vindo!</MudText>
        <MudCard Class="p-4" Style="border-radius: 12px;box-shadow: none;">
            @* <MudCardHeader Class="texts-login">
                <MudText Typo="Typo.h4" Class="text-center" Style="color: #4169E1;">Bem-vindo!</MudText>
                <MudText Typo="Typo.body2" Class="text-center" Style="color: gray;">Entre com suas credenciais</MudText>
            </MudCardHeader> *@
            <MudCardContent>
                <MudForm Model="@loginModel">
                    <MudTextField Style="padding: 0.5rem; border-radius: 8px; background: #f4f4f2;" Placeholder="E-mail" Label="E-mail" @bind-Value="loginModel.Email" Required="true" RequiredError="O e-mail é obrigatório." Adornment="Adornment.Start" Variant="Variant.Outlined" />
                    <MudTextField Style="padding: 0.5rem; border-radius: 8px; background: #f4f4f2;" Placeholder="Senha" Label="Senha" @bind-Value="loginModel.Senha" InputType="InputType.Password" Required="true" RequiredError="A senha é obrigatória." Adornment="Adornment.Start" Variant="Variant.Outlined" />
                    <MudButton OnClick="Logar" Color="Color.Primary" Class="mt-4" FullWidth Style="background-color: #2274a8; color: white; font-weight: bold; width: fit-content; margin: auto;">Entrar</MudButton>
                </MudForm>
                <MudText Class="mt-3 text-center">
                    <MudLink OnClick="EsqueceuSenha" Class="cursor-pointer" Style="color: #2274a8 !important;">Esqueceu a senha?</MudLink>
                </MudText>
                <MudText Class="mt-3 text-center">
                    <MudLink OnClick="Registrar" Class="cursor-pointer" Style="padding: 0.5rem; border-radius: 12px; border: 1px solid #2274a8!important; color: #2274a8 !important;">Ainda não tem uma conta? Registre-se</MudLink>
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudPaper>
</MudContainer>

@code {
    private LoginModel loginModel = new LoginModel();

    private async Task Logar()
    {
        var user = await FirestoreService.Login(loginModel.Email, loginModel.Senha);
        if (user != null && user != false)
        {
            // Snackbar.Add("Login realizado com sucesso!", Severity.Success);
            FirestoreService.SetAuthenticated(true);
            navigation.NavigateTo(navigation.BaseUri);
        }
        else
        {
            Snackbar.Add("E-mail ou senha incorretos.", Severity.Error);
        }
    }

    private void EsqueceuSenha()
    {
        navigation.NavigateTo("esqueceuSenha");
    }

    private void Registrar()
    {
        navigation.NavigateTo("registrar");
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }
}


<style>
    .texts-login{
        @@media(max-width: 700px) {
            flex-direction: column;
        }
    }
</style>